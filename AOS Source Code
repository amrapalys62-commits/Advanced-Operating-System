<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Intelligent Disk I/O Scheduling Analyser</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            background-color: #020203;
            background-image: 
                radial-gradient(circle at 50% 20%, rgba(6, 182, 212, 0.1) 0%, transparent 70%),
                linear-gradient(to right, rgba(6, 182, 212, 0.05) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(6, 182, 212, 0.05) 1px, transparent 1px);
            background-size: 100% 100%, 35px 35px, 35px 35px;
            color: #e4e4e7;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            position: relative;
            min-height: 100vh;
            overflow-x: hidden;
            cursor: crosshair;
        }
        
        .watermark-bg {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-25deg);
            font-size: 9rem;
            font-weight: 900;
            color: rgba(255, 255, 255, 0.012);
            pointer-events: none;
            white-space: nowrap;
            z-index: 0;
            user-select: none;
            letter-spacing: 0.1em;
        }

        .custom-card {
            background-color: rgba(9, 9, 11, 0.85);
            backdrop-filter: blur(8px);
            border: 1px solid #18181b;
        }

        input, select {
            background-color: #121215 !important;
            border-color: #27272a !important;
            color: #f4f4f5 !important;
        }

        input:focus, select:focus {
            border-color: #06b6d4 !important;
            outline: none;
            box-shadow: 0 0 8px rgba(6, 182, 212, 0.3);
        }

        #landing-page {
            position: fixed;
            inset: 0;
            background-color: #020203;
            background-image: 
                radial-gradient(circle at 50% 50%, rgba(6, 182, 212, 0.15) 0%, rgba(2, 2, 3, 0.96) 80%),
                linear-gradient(to right, rgba(6, 182, 212, 0.07) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(6, 182, 212, 0.07) 1px, transparent 1px);
            background-size: 100% 100%, 30px 30px, 30px 30px;
            z-index: 50;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: opacity 0.6s ease, visibility 0.6s ease;
            overflow: hidden;
        }

        #landing-page.hidden-screen {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        #particleCanvas {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 1;
        }

        .loader-bar {
            width: 0%;
            transition: width 0.3s ease;
        }

        .pulse-glow {
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.35);
        }

        @keyframes spinDisk {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .disk-platter {
            animation: spinDisk 3s linear infinite;
        }

        #interactiveDiskWidget {
            transition: transform 0.1s ease-out;
        }

        #loaderActuatorArm {
            transform-origin: top right;
            transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .disk-spark {
            position: absolute;
            width: 16px;
            height: 16px;
            border: 2px solid #06b6d4;
            border-radius: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
            animation: sparkAnim 0.5s ease-out forwards;
            z-index: 9999;
        }

        @keyframes sparkAnim {
            0% { width: 10px; height: 10px; opacity: 1; box-shadow: 0 0 10px #06b6d4; }
            100% { width: 50px; height: 50px; opacity: 0; box-shadow: 0 0 25px #10b981; }
        }
    </style>
</head>
<body class="p-4 md:p-8" onclick="triggerDiskSeekEffect(event)">

    <!-- Watermark -->
    <div class="watermark-bg">Amrapaly Sarkar</div>

    <!-- STARTING & LOADING PAGE OVERLAY -->
    <div id="landing-page" onmousemove="handleLoaderMouseMove(event)">
        <canvas id="particleCanvas"></canvas>

        <div class="watermark-bg">Amrapaly Sarkar</div>
        <div class="max-w-md w-full px-6 text-center space-y-6 relative z-10">
            
            <div id="interactiveDiskWidget" class="relative inline-flex items-center justify-center w-32 h-32 mx-auto rounded-full bg-cyan-950/50 border border-cyan-500/40 pulse-glow mb-2 cursor-pointer shadow-[0_0_30px_rgba(6,182,212,0.2)]">
                <div class="absolute inset-1 rounded-full border border-dashed border-cyan-400/40 disk-platter"></div>
                <div class="absolute inset-5 rounded-full border border-zinc-800 disk-platter" style="animation-direction: reverse; animation-duration: 5s;"></div>
                <div class="absolute inset-10 rounded-full border border-cyan-400/30"></div>
                
                <div class="w-8 h-8 rounded-full bg-zinc-900 border border-cyan-400/80 flex items-center justify-center shadow-inner z-10">
                    <div class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-ping"></div>
                </div>

                <div id="loaderActuatorArm" class="absolute top-3 right-6 w-14 h-6 pointer-events-none z-20">
                    <div class="w-full h-1 bg-cyan-400 rounded-full shadow-[0_0_10px_#06b6d4]"></div>
                    <div class="absolute right-0 top-1 w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_6px_#10b981]"></div>
                </div>

                <div class="absolute inset-0 animate-spin" style="animation-duration: 2s;">
                    <div class="w-2 h-2 bg-cyan-400 rounded-full shadow-[0_0_8px_#06b6d4] absolute top-2 left-1/2"></div>
                </div>
            </div>
            
            <div>
                <h1 class="text-3xl font-extrabold tracking-tight text-zinc-100">
                    Intelligent Disk I/O
                </h1>
                <h2 class="text-xl font-bold text-cyan-400 mt-1">
                    Scheduling Analyser
                </h2>
                <p class="text-xs text-zinc-400 mt-2">
                    Advanced Operating Systems Project • Authored by <span class="text-zinc-200 font-semibold">Amrapaly Sarkar</span>
                </p>
            </div>

            <!-- Start Button Stage -->
            <div id="start-action" class="pt-2">
                <button onclick="startLoadingProcess(); event.stopPropagation();" class="w-full bg-cyan-500 hover:bg-cyan-400 text-black font-bold py-3.5 px-6 rounded-xl text-sm transition-all duration-200 pulse-glow transform hover:scale-[1.02]">
                    Launch System Simulation
                </button>
            </div>

            <!-- Loading Progress Stage -->
            <div id="loading-action" class="space-y-3 hidden">
                <div class="w-full bg-zinc-900 border border-zinc-800 rounded-full h-2 overflow-hidden shadow-inner">
                    <div id="progress-bar" class="bg-cyan-400 h-full loader-bar shadow-[0_0_10px_#06b6d4]"></div>
                </div>
                <p id="loading-status" class="text-xs text-cyan-400 font-mono animate-pulse">Initializing kernel module...</p>
            </div>
        </div>
    </div>

    <!-- MAIN ANALYSER INTERFACE -->
    <div class="max-w-7xl mx-auto space-y-6 relative z-10">
        <!-- Header -->
        <header class="custom-card p-6 rounded-xl border flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-cyan-400 flex items-center gap-2">
                    <span>⚡ Intelligent Disk I/O Scheduling Analyser</span>
                </h1>
                <p class="text-xs text-zinc-400 mt-1">Advanced Operating Systems Mini Project • Algorithm Evaluation Suite</p>
            </div>
            <div class="text-right flex flex-col items-end">
                <span class="text-xs px-3 py-1 rounded-full bg-cyan-950/80 text-cyan-400 border border-cyan-800/50 font-mono">Project Owner: Amrapaly Sarkar</span>
                <span id="headStatusBadge" class="text-[10px] text-emerald-400 mt-1 font-mono">Actuator State: Awaiting Input Parameters</span>
            </div>
        </header>

        <!-- Main Layout Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- Controls Panel -->
            <div class="lg:col-span-4 space-y-6">
                <div class="custom-card p-6 rounded-xl border space-y-4">
                    <h2 class="text-base font-semibold text-zinc-200 border-b border-zinc-800 pb-3">Input Parameters</h2>
                    
                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-1">Request Queue (Comma Separated)</label>
                        <input type="text" id="requestsInput" class="w-full px-3 py-2 text-sm rounded-lg border font-mono" placeholder="e.g. 98, 183, 37, 122, 14">
                        <p class="text-[11px] text-zinc-500 mt-1">Enter target track numbers separated by commas.</p>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-medium text-zinc-400 mb-1">Initial Head Position</label>
                            <input type="number" id="headInput" value="53" class="w-full px-3 py-2 text-sm rounded-lg border font-mono">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-zinc-400 mb-1">Total Disk Tracks</label>
                            <input type="number" id="maxTrackInput" value="199" class="w-full px-3 py-2 text-sm rounded-lg border font-mono">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-1">Initial Head Movement Direction</label>
                        <select id="directionInput" class="w-full px-3 py-2 text-sm rounded-lg border">
                            <option value="right" selected>Right (Increasing / Towards End)</option>
                            <option value="left">Left (Decreasing / Towards 0)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-1">Workload Preset Scenarios</label>
                        <select id="presetSelect" onchange="loadPresetWorkload(this.value)" onclick="event.stopPropagation()" class="w-full px-3 py-2 text-sm rounded-lg border">
                            <option value="" disabled selected>Select a preset workload...</option>
                            <option value="textbook">Textbook Classic (98, 183, 37, 122, 14, 124, 65, 67)</option>
                            <option value="sequential">Sequential Heavy (10, 20, 30, 40, 50, 60, 70, 80)</option>
                            <option value="worst">Worst-Case FCFS (0, 199, 1, 198, 2, 197)</option>
                            <option value="cluster">Bi-Modal Cluster (15, 18, 22, 180, 185, 190, 25)</option>
                        </select>
                    </div>

                    <div class="pt-2 flex gap-2">
                        <button onclick="calculateAll(); event.stopPropagation();" class="flex-1 bg-cyan-600 hover:bg-cyan-500 text-black font-bold py-2.5 px-4 rounded-lg text-sm transition-colors">
                            Run Analysis
                        </button>
                        <button onclick="generateRandomQueue(); event.stopPropagation();" class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-medium py-2.5 px-3 rounded-lg text-sm transition-colors" title="Generate Random Requests">
                            🎲
                        </button>
                    </div>
                </div>

                <!-- ALGORITHM INFO CARD -->
                <div class="custom-card p-5 rounded-xl border border-cyan-900/50 bg-gradient-to-br from-cyan-950/20 to-zinc-950 space-y-2">
                    <div class="flex items-center justify-between">
                        <h3 class="text-xs font-semibold uppercase tracking-wider text-cyan-400" id="infoCardTitle">Algorithm Insight</h3>
                        <span class="text-[10px] font-mono text-zinc-500">Selected Policy Info</span>
                    </div>
                    <p id="algorithmInfoText" class="text-xs text-zinc-300 leading-relaxed font-mono">
                        Processes I/O requests strictly in the exact order they arrive in the queue without any reordering.
                    </p>
                </div>

                <!-- Best Strategy Summary -->
                <div class="custom-card p-6 rounded-xl border border-emerald-900/40 bg-gradient-to-br from-emerald-950/20 to-zinc-950">
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-2">Optimal Algorithm Strategy</h3>
                    <div id="optimalSummary" class="text-sm text-zinc-300">
                        Enter system values and run analysis to discover the optimal scheduling policy.
                    </div>
                </div>

                <!-- Hardware Latency Settings -->
                <div class="custom-card p-6 rounded-xl border space-y-3">
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Estimated Seek Latency</h3>
                    <div class="flex justify-between items-center text-xs">
                        <span class="text-zinc-400">Seek Time / Cylinder:</span>
                        <span class="font-mono text-cyan-400">2.0 ms</span>
                    </div>
                    <div id="latencyOutput" class="text-xs font-mono text-zinc-300 pt-1 border-t border-zinc-800">
                        Run analysis to calculate estimated rotational seek delay.
                    </div>
                </div>
            </div>

            <!-- Visualization & Results Panel -->
            <div class="lg:col-span-8 space-y-6">
                
                <!-- Trajectory Canvas Visualizer (Vertical Layout) -->
                <div class="custom-card p-6 rounded-xl border space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-zinc-800 pb-3">
                        <div class="flex items-center gap-3">
                            <h2 class="text-base font-semibold text-zinc-200">Vertical Track Trajectory</h2>
                            <!-- Playback Control & Exit Toolbar -->
                            <div class="flex items-center gap-1 bg-zinc-900 border border-zinc-800 rounded-lg p-1">
                                <button onclick="startPlayback(); event.stopPropagation();" class="px-2.5 py-1 text-xs bg-cyan-600 hover:bg-cyan-500 text-black font-bold rounded" title="Play Animation">▶ Play</button>
                                <button onclick="pausePlayback(); event.stopPropagation();" class="px-2.5 py-1 text-xs bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded" title="Pause Animation">⏸ Pause</button>
                                <button onclick="resetPlayback(); event.stopPropagation();" class="px-2.5 py-1 text-xs bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded" title="Reset Animation">⏹ Reset</button>
                                <button onclick="exitSimulation(); event.stopPropagation();" class="px-2.5 py-1 text-xs bg-rose-950 hover:bg-rose-900 text-rose-300 border border-rose-800/60 font-semibold rounded" title="Exit Simulation">⏏ Exit</button>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <label class="text-xs text-zinc-400">Selected Algorithm:</label>
                            <select id="algoSelect" onchange="updateAlgorithmInfo(); resetPlayback(); drawTrajectory();" onclick="event.stopPropagation()" class="px-3 py-1.5 text-xs rounded-lg border font-medium">
                                <option value="FCFS">FCFS (First-Come, First-Served)</option>
                                <option value="SSTF">SSTF (Shortest Seek Time First)</option>
                                <option value="SCAN">SCAN (Elevator Algorithm)</option>
                                <option value="C-SCAN">C-SCAN (Circular SCAN)</option>
                                <option value="LOOK">LOOK</option>
                                <option value="C-LOOK">C-LOOK (Circular LOOK)</option>
                            </select>
                        </div>
                    </div>

                    <div class="relative flex">
                        <!-- Vertical Axis Track Labels on Left -->
                        <div class="flex flex-col justify-between text-[10px] text-zinc-500 font-mono pr-2 py-2 select-none h-96 text-right">
                            <span>Track <span id="maxTrackLabel">199</span></span>
                            <span>Track 150</span>
                            <span>Track 100</span>
                            <span>Track 50</span>
                            <span>Track 0</span>
                        </div>
                        <canvas id="trajectoryCanvas" class="w-full h-96 rounded-lg bg-black/90 border border-zinc-800/80 cursor-pointer" onclick="handleCanvasClick(event)" title="Click to add track request"></canvas>
                    </div>
                    <div class="text-center text-[11px] text-zinc-500 font-mono">
                        <span class="text-cyan-500">💡 Vertical Axis represents Disk Tracks (0 at bottom, Max at top) • Horizontal axis represents sequence steps</span>
                    </div>
                </div>

                <!-- Results Output Table -->
                <div class="custom-card p-6 rounded-xl border space-y-3">
                    <h2 class="text-base font-semibold text-zinc-200">Algorithm Performance Metrics</h2>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs font-mono">
                            <thead class="bg-zinc-900 text-zinc-400 border-b border-zinc-800">
                                <tr>
                                    <th class="p-3">Algorithm</th>
                                    <th class="p-3">Seek Sequence</th>
                                    <th class="p-3 text-right">Total Head Movement (Seek Count)</th>
                                </tr>
                            </thead>
                            <tbody id="resultsTableBody" class="divide-y divide-zinc-900 text-zinc-300">
                                <tr>
                                    <td colspan="3" class="p-4 text-center text-zinc-500">Awaiting simulation execution...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- JavaScript Engine -->
    <script>
        let currentAnimIndex = 0;
        let animTimer = null;
        let lastResults = {};

        const algoDescriptions = {
            'FCFS': "Processes I/O requests strictly in the exact arrival sequence order without reordering, often leading to excessive mechanical head movement.",
            'SSTF': "Services the request closest to the current head position first, significantly reducing total seek time but risking potential request starvation.",
            'SCAN': "Moves the disk arm continuously in one direction servicing requests until reaching the boundary, then reverses direction like an elevator.",
            'C-SCAN': "Traverses disk tracks in only one direction; upon hitting the edge, the head instantly returns to zero without servicing on return.",
            'LOOK': "Similar to SCAN, but the arm reverses direction immediately after servicing the last request in the current path without hitting the physical edge.",
            'C-LOOK': "Similar to C-LOOK, but the arm only travels as far as the last request in each direction before instantly jumping back to the opposite end."
        };

        function updateAlgorithmInfo() {
            const selectedAlgo = document.getElementById('algoSelect').value;
            document.getElementById('infoCardTitle').innerText = `${selectedAlgo} Insight`;
            document.getElementById('algorithmInfoText').innerText = algoDescriptions[selectedAlgo] || "Select an algorithm to view operational details.";
        }

        // --- Interactive Particle Node Network Animation ---
        const pCanvas = document.getElementById('particleCanvas');
        const pCtx = pCanvas.getContext('2d');
        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight / 2;

        function resizeParticleCanvas() {
            pCanvas.width = window.innerWidth;
            pCanvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeParticleCanvas);
        resizeParticleCanvas();

        let particles = [];
        for (let i = 0; i < 55; i++) {
            particles.push({
                x: Math.random() * pCanvas.width,
                y: Math.random() * pCanvas.height,
                vx: (Math.random() - 0.5) * 1.2,
                vy: (Math.random() - 0.5) * 1.2,
                size: Math.random() * 2.5 + 1
            });
        }

        function drawParticles() {
            pCtx.fillStyle = 'rgba(2, 2, 3, 0.2)';
            pCtx.fillRect(0, 0, pCanvas.width, pCanvas.height);

            particles.forEach((p, index) => {
                p.x += p.vx;
                p.y += p.vy;

                if (p.x < 0 || p.x > pCanvas.width) p.vx *= -1;
                if (p.y < 0 || p.y > pCanvas.height) p.vy *= -1;

                pCtx.fillStyle = 'rgba(6, 182, 212, 0.7)';
                pCtx.beginPath();
                pCtx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                pCtx.fill();

                for (let j = index + 1; j < particles.length; j++) {
                    let p2 = particles[j];
                    let d = Math.hypot(p.x - p2.x, p.y - p2.y);
                    if (d < 90) {
                        pCtx.strokeStyle = `rgba(6, 182, 212, ${0.2 * (1 - d / 90)})`;
                        pCtx.lineWidth = 0.5;
                        pCtx.beginPath();
                        pCtx.moveTo(p.x, p.y);
                        pCtx.lineTo(p2.x, p2.y);
                        pCtx.stroke();
                    }
                }

                let dist = Math.hypot(mouseX - p.x, mouseY - p.y);
                if (dist < 130) {
                    pCtx.strokeStyle = `rgba(6, 182, 212, ${1 - dist / 130})`;
                    pCtx.lineWidth = 1;
                    pCtx.beginPath();
                    pCtx.moveTo(p.x, p.y);
                    pCtx.lineTo(mouseX, mouseY);
                    pCtx.stroke();
                }
            });

            requestAnimationFrame(drawParticles);
        }
        drawParticles();

        function triggerDiskSeekEffect(e) {
            const spark = document.createElement('div');
            spark.className = 'disk-spark';
            spark.style.left = e.pageX + 'px';
            spark.style.top = e.pageY + 'px';
            document.body.appendChild(spark);
            setTimeout(() => spark.remove(), 500);
        }

        function handleLoaderMouseMove(e) {
            mouseX = e.clientX;
            mouseY = e.clientY;

            const widget = document.getElementById('interactiveDiskWidget');
            const arm = document.getElementById('loaderActuatorArm');
            if (!widget || !arm) return;

            const rect = widget.getBoundingClientRect();
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;

            const angle = Math.atan2(e.clientY - centerY, e.clientX - centerX) * (180 / Math.PI);
            arm.style.transform = `rotate(${angle * 0.4}deg)`;
            widget.style.transform = `translate(${(e.clientX - centerX) * 0.05}px, ${(e.clientY - centerY) * 0.05}px)`;
        }

        function startLoadingProcess() {
            const landing = document.getElementById('landing-page');
            const startAction = document.getElementById('start-action');
            const loadingAction = document.getElementById('loading-action');
            const progressBar = document.getElementById('progress-bar');
            const loadingStatus = document.getElementById('loading-status');

            startAction.classList.add('hidden');
            loadingAction.classList.remove('hidden');

            const steps = [
                { progress: '30%', text: 'Allocating disk sector buffers...' },
                { progress: '65%', text: 'Calibrating actuator arm parameters...' },
                { progress: '90%', text: 'Compiling scheduling policies...' },
                { progress: '100%', text: 'System simulation ready!' }
            ];

            let step = 0;
            const interval = setInterval(() => {
                if (step < steps.length) {
                    progressBar.style.width = steps[step].progress;
                    loadingStatus.innerText = steps[step].text;
                    step++;
                } else {
                    clearInterval(interval);
                    setTimeout(() => {
                        landing.classList.add('hidden-screen');
                        if (!document.getElementById('requestsInput').value) {
                            document.getElementById('requestsInput').value = '98, 183, 37, 122, 14, 124, 65, 67';
                        }
                        updateAlgorithmInfo();
                        calculateAll();
                    }, 400);
                }
            }, 350);
        }

        function exitSimulation() {
            if (animTimer) clearInterval(animTimer);
            const landing = document.getElementById('landing-page');
            const startAction = document.getElementById('start-action');
            const loadingAction = document.getElementById('loading-action');
            const progressBar = document.getElementById('progress-bar');

            // Reset landing screen states
            loadingAction.classList.add('hidden');
            startAction.classList.remove('hidden');
            progressBar.style.width = '0%';
            
            landing.classList.remove('hidden-screen');
            document.getElementById('headStatusBadge').innerText = 'Actuator State: Awaiting Input Parameters';
        }

        function loadPresetWorkload(type) {
            const presets = {
                textbook: '98, 183, 37, 122, 14, 124, 65, 67',
                sequential: '10, 20, 30, 40, 50, 60, 70, 80',
                worst: '0, 199, 1, 198, 2, 197',
                cluster: '15, 18, 22, 180, 185, 190, 25'
            };
            if (presets[type]) {
                document.getElementById('requestsInput').value = presets[type];
                calculateAll();
            }
        }

        function generateRandomQueue() {
            const maxTrack = parseInt(document.getElementById('maxTrackInput').value) || 199;
            const count = Math.floor(Math.random() * 6) + 5;
            let reqs = [];
            for (let i = 0; i < count; i++) {
                reqs.push(Math.floor(Math.random() * (maxTrack + 1)));
            }
            document.getElementById('requestsInput').value = reqs.join(', ');
            calculateAll();
        }

        function handleCanvasClick(event) {
            event.stopPropagation();
            const canvas = document.getElementById('trajectoryCanvas');
            const rect = canvas.getBoundingClientRect();
            const yClick = event.clientY - rect.top;
            const maxTrack = parseInt(document.getElementById('maxTrackInput').value) || 199;
            
            const usableHeight = canvas.height - 60;
            let trackValue = Math.round(((canvas.height - 30 - yClick) / usableHeight) * maxTrack);
            trackValue = Math.max(0, Math.min(maxTrack, trackValue));

            const reqInput = document.getElementById('requestsInput');
            if (reqInput.value.trim() === '') {
                reqInput.value = trackValue;
            } else {
                reqInput.value += ', ' + trackValue;
            }
            calculateAll();
        }

        function parseInputs() {
            const reqStr = document.getElementById('requestsInput').value;
            const requests = reqStr.split(',').map(s => parseInt(s.trim())).filter(n => !isNaN(n));
            const head = parseInt(document.getElementById('headInput').value) || 0;
            const maxTrack = parseInt(document.getElementById('maxTrackInput').value) || 199;
            const direction = document.getElementById('directionInput').value || 'right';

            document.getElementById('maxTrackLabel').innerText = maxTrack;
            return { requests, head, maxTrack, direction };
        }

        // --- Scheduling Algorithms ---
        function runFCFS(requests, head) {
            let sequence = [head, ...requests];
            let seekCount = 0;
            for (let i = 0; i < requests.length; i++) {
                seekCount += Math.abs(sequence[i+1] - sequence[i]);
            }
            return { sequence, seekCount };
        }

        function runSSTF(requests, head) {
            let reqs = [...requests];
            let sequence = [head];
            let seekCount = 0;
            let current = head;

            while (reqs.length > 0) {
                let closestIdx = 0;
                let minDist = Math.abs(reqs[0] - current);
                for (let i = 1; i < reqs.length; i++) {
                    let dist = Math.abs(reqs[i] - current);
                    if (dist < minDist) {
                        minDist = dist;
                        closestIdx = i;
                    }
                }
                current = reqs.splice(closestIdx, 1)[0];
                sequence.push(current);
                seekCount += minDist;
            }
            return { sequence, seekCount };
        }

        function runSCAN(requests, head, maxTrack, direction) {
            let sequence = [head];
            let seekCount = 0;
            let left = requests.filter(r => r < head).sort((a,b) => a - b);
            let right = requests.filter(r => r >= head).sort((a,b) => a - b);
            let current = head;

            if (direction === 'right') {
                right.forEach(r => { sequence.push(r); seekCount += Math.abs(r - current); current = r; });
                if (left.length > 0 || right.length > 0) {
                    if (current !== maxTrack) {
                        seekCount += Math.abs(maxTrack - current);
                        current = maxTrack;
                        sequence.push(current);
                    }
                    left.reverse().forEach(r => { sequence.push(r); seekCount += Math.abs(r - current); current = r; });
                }
            } else {
                left.reverse().forEach(r => { sequence.push(r); seekCount += Math.abs(r - current); current = r; });
                if (left.length > 0 || right.length > 0) {
                    if (current !== 0) {
                        seekCount += Math.abs(0 - current);
                        current = 0;
                        sequence.push(current);
                    }
                    right.forEach(r => { sequence.push(r); seekCount += Math.abs(r - current); current = r; });
                }
            }
            return { sequence, seekCount };
        }

        function runCSCAN(requests, head, maxTrack, direction) {
            let sequence = [head];
            let seekCount = 0;
            let left = requests.filter(r => r < head).sort((a,b) => a - b);
            let right = requests.filter(r => r >= head).sort((a,b) => a - b);
            let current = head;

            if (direction === 'right') {
                right.forEach(r => { sequence.push(r); seekCount += Math.abs(r - current); current = r; });
                if (left.length > 0 || right.length > 0) {
                    if (current !== maxTrack) {
                        seekCount += Math.abs(maxTrack - current);
                        current = maxTrack;
                        sequence.push(current);
                    }
                    seekCount += Math.abs(maxTrack - 0);
                    current = 0;
                    sequence.push(current);
                    left.forEach(r => { sequence.push(r); seekCount += Math.abs(r - current); current = r; });
                }
            } else {
                left.reverse().forEach(r => { sequence.push(r); seekCount += Math.abs(r - current); current = r; });
                if (left.length > 0 || right.length > 0) {
                    if (current !== 0) {
                        seekCount += Math.abs(0 - current);
                        current = 0;
                        sequence.push(current);
                    }
                    seekCount += Math.abs(maxTrack - 0);
                    current = maxTrack;
                    sequence.push(current);
                    right.reverse().forEach(r => { sequence.push(r); seekCount += Math.abs(r - current); current = r; });
                }
            }
            return { sequence, seekCount };
        }

        function runLOOK(requests, head, maxTrack, direction) {
            let sequence = [head];
            let seekCount = 0;
            let left = requests.filter(r => r < head).sort((a,b) => a - b);
            let right = requests.filter(r => r >= head).sort((a,b) => a - b);
            let current = head;

            if (direction === 'right') {
                right.forEach(r => { sequence.push(r); seekCount += Math.abs(r - current); current = r; });
                left.reverse().forEach(r => { sequence.push(r); seekCount += Math.abs(r - current); current = r; });
            } else {
                left.reverse().forEach(r => { sequence.push(r); seekCount += Math.abs(r - current); current = r; });
                right.forEach(r => { sequence.push(r); seekCount += Math.abs(r - current); current = r; });
            }
            return { sequence, seekCount };
        }

        function runCLOOK(requests, head, maxTrack, direction) {
            let sequence = [head];
            let seekCount = 0;
            let left = requests.filter(r => r < head).sort((a,b) => a - b);
            let right = requests.filter(r => r >= head).sort((a,b) => a - b);
            let current = head;

            if (direction === 'right') {
                right.forEach(r => { sequence.push(r); seekCount += Math.abs(r - current); current = r; });
                if (left.length > 0) {
                    let lowest = left[0];
                    seekCount += Math.abs(lowest - current);
                    current = lowest;
                    sequence.push(current);
                    left.slice(1).forEach(r => { sequence.push(r); seekCount += Math.abs(r - current); current = r; });
                }
            } else {
                left.reverse().forEach(r => { sequence.push(r); seekCount += Math.abs(r - current); current = r; });
                if (right.length > 0) {
                    let highest = right[right.length - 1];
                    seekCount += Math.abs(highest - current);
                    current = highest;
                    sequence.push(current);
                    right.slice(0, right.length - 1).reverse().forEach(r => { sequence.push(r); seekCount += Math.abs(r - current); current = r; });
                }
            }
            return { sequence, seekCount };
        }

        function calculateAll() {
            const { requests, head, maxTrack, direction } = parseInputs();
            if (requests.length === 0) {
                document.getElementById('resultsTableBody').innerHTML = `<tr><td colspan="3" class="p-4 text-center text-amber-400">Please enter a valid request queue.</td></tr>`;
                return;
            }

            lastResults = {
                'FCFS': runFCFS(requests, head),
                'SSTF': runSSTF(requests, head),
                'SCAN': runSCAN(requests, head, maxTrack, direction),
                'C-SCAN': runCSCAN(requests, head, maxTrack, direction),
                'LOOK': runLOOK(requests, head, maxTrack, direction),
                'C-LOOK': runCLOOK(requests, head, maxTrack, direction)
            };

            let tbody = '';
            let bestAlgo = '';
            let minSeek = Infinity;

            for (let algo in lastResults) {
                let res = lastResults[algo];
                if (res.seekCount < minSeek) {
                    minSeek = res.seekCount;
                    bestAlgo = algo;
                }
                tbody += `
                    <tr class="hover:bg-zinc-900/60 transition-colors">
                        <td class="p-3 font-semibold text-cyan-400">${algo}</td>
                        <td class="p-3 font-mono text-zinc-400 truncate max-w-xs" title="${res.sequence.join(' → ')}">${res.sequence.join(' → ')}</td>
                        <td class="p-3 text-right font-bold text-zinc-200">${res.seekCount} cylinders</td>
                    </tr>
                `;
            }

            document.getElementById('resultsTableBody').innerHTML = tbody;
            document.getElementById('optimalSummary').innerHTML = `
                <span class="text-emerald-400 font-bold">${bestAlgo}</span> achieved the lowest total movement with <span class="font-bold text-white">${minSeek} cylinders</span> for this workload queue.
            `;
            document.getElementById('headStatusBadge').innerText = 'Actuator State: Analysis Complete & Plotting...';
            
            let latencyMs = (minSeek * 2.0).toFixed(1);
            document.getElementById('latencyOutput').innerText = `Optimal (${bestAlgo}): ~${latencyMs} ms latency`;

            startAnalysisPlotAnimation();
        }

        function startAnalysisPlotAnimation() {
            const selectedAlgo = document.getElementById('algoSelect').value;
            if (!lastResults[selectedAlgo]) return;
            const sequence = lastResults[selectedAlgo].sequence;

            if (animTimer) clearInterval(animTimer);
            currentAnimIndex = 0;

            animTimer = setInterval(() => {
                if (currentAnimIndex <= sequence.length) {
                    drawTrajectory();
                    currentAnimIndex++;
                } else {
                    clearInterval(animTimer);
                    document.getElementById('headStatusBadge').innerText = 'Actuator State: Plotting Complete';
                }
            }, 180);
        }

        function startPlayback() {
            const selectedAlgo = document.getElementById('algoSelect').value;
            if (!lastResults[selectedAlgo]) return;
            const sequence = lastResults[selectedAlgo].sequence;

            if (animTimer) clearInterval(animTimer);
            animTimer = setInterval(() => {
                if (currentAnimIndex < sequence.length) {
                    currentAnimIndex++;
                    drawTrajectory();
                } else {
                    clearInterval(animTimer);
                }
            }, 180);
            document.getElementById('headStatusBadge').innerText = `Actuator State: Simulating ${selectedAlgo}...`;
        }

        function pausePlayback() {
            if (animTimer) clearInterval(animTimer);
            document.getElementById('headStatusBadge').innerText = 'Actuator State: Playback Paused';
        }

        function resetPlayback() {
            if (animTimer) clearInterval(animTimer);
            currentAnimIndex = 0;
            drawTrajectory();
        }

        function drawTrajectory() {
            const canvas = document.getElementById('trajectoryCanvas');
            const ctx = canvas.getContext('2d');
            const selectedAlgo = document.getElementById('algoSelect').value;
            const { maxTrack } = parseInputs();

            canvas.width = canvas.parentElement.clientWidth - 70;
            canvas.height = 384;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            const padX = 40;
            const padY = 30;
            const graphWidth = canvas.width - (padX * 2);
            const graphHeight = canvas.height - (padY * 2);

            ctx.strokeStyle = '#18181b';
            ctx.lineWidth = 1;
            for (let i = 0; i <= 4; i++) {
                let y = padY + (graphHeight / 4) * i;
                ctx.beginPath();
                ctx.moveTo(padX, y);
                ctx.lineTo(canvas.width - padX, y);
                ctx.stroke();
            }

            if (!lastResults[selectedAlgo]) return;
            const sequence = lastResults[selectedAlgo].sequence;
            if (sequence.length === 0) return;

            if (currentAnimIndex === 0) currentAnimIndex = 1;
            let activeLen = Math.min(currentAnimIndex, sequence.length);

            const stepX = graphWidth / Math.max(1, sequence.length - 1);

            let points = sequence.map((track, idx) => {
                let x = padX + (idx * stepX);
                let y = padY + graphHeight - ((track / maxTrack) * graphHeight);
                return { x, y, track };
            });

            ctx.beginPath();
            ctx.strokeStyle = '#06b6d4';
            ctx.lineWidth = 2.5;

            for (let i = 0; i < activeLen; i++) {
                if (i === 0) ctx.moveTo(points[i].x, points[i].y);
                else ctx.lineTo(points[i].x, points[i].y);
            }
            ctx.stroke();

            for (let i = 0; i < activeLen; i++) {
                let pt = points[i];
                ctx.fillStyle = i === 0 ? '#10b981' : (i === activeLen - 1 ? '#f59e0b' : '#06b6d4');
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, i === activeLen - 1 ? 6 : 4, 0, Math.PI * 2);
                ctx.fill();

                ctx.fillStyle = '#a1a1aa';
                ctx.font = '10px monospace';
                ctx.textAlign = 'center';
                ctx.fillText(pt.track, pt.x, pt.y < 20 ? pt.y + 16 : pt.y - 10);
            }
        }
    </script>
